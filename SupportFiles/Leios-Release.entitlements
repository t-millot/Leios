<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Release entitlements for the Leios app: the Debug set plus the CloudKit environment.

    A Developer ID build must name Production explicitly, or CloudKit refuses to start with
    "Unsatisfied entitlements: com.apple.developer.icloud-container-environment". The schema has
    to be promoted in the CloudKit Console (Development -> Deploy Schema Changes) before a build
    carrying this file will find the record type; Scripts/release.sh says so in its preflight.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.tmillot.Leios</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
</dict>
</plist>
